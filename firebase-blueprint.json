      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "classroomId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "classroomName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "teacherUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "studentUids": { "type": "array" },
        "title": { "type": "string", "minLength": 2, "maxLength": 160 },
        "activityType": { "type": "string", "enum": ["lab", "revision_clinic", "discussion", "assignment"] },
        "scheduledDate": { "type": "string", "minLength": 4, "maxLength": 40 },
        "description": { "type": "string", "maxLength": 1000 },
        "completed": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "classroomId", "classroomName", "teacherUid", "studentUids", "title", "activityType", "scheduledDate", "description", "completed", "createdAt"]
    },
    "QuestionBankItem": {
      "title": "QuestionBankItem",
      "description": "Teacher-curated reusable question bank item mapped to a specific curriculum concept.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "teacherUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "subject": { "type": "string", "minLength": 1, "maxLength": 80 },
        "conceptId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "conceptName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "prompt": { "type": "string", "minLength": 3, "maxLength": 1000 },
        "type": { "type": "string", "enum": ["mcq", "short_answer"] },
        "options": { "type": "array" },
        "correctAnswer": { "type": "string", "minLength": 1, "maxLength": 400 },
        "explanation": { "type": "string", "maxLength": 1000 },
        "points": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "teacherUid", "subject", "conceptId", "conceptName", "prompt", "type", "correctAnswer", "explanation", "points", "createdAt"]
    },
    "StudentStudyNote": {
      "title": "StudentStudyNote",
      "description": "Personal student study note in English or Kannada linked to a classroom and optional concept.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "classroomId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "studentUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "conceptId": { "type": "string", "maxLength": 128 },
        "conceptName": { "type": "string", "maxLength": 160 },
        "title": { "type": "string", "minLength": 2, "maxLength": 140 },
        "content": { "type": "string", "minLength": 2, "maxLength": 4000 },
        "language": { "type": "string", "enum": ["en", "kn"] },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "classroomId", "studentUid", "title", "content", "language", "updatedAt", "createdAt"]
    },
    "CurriculumTopicProgress": {
      "title": "CurriculumTopicProgress",
      "description": "Per-student DBMS curriculum topic completion tracking and last viewed topic.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "studentUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "curriculumId": { "type": "string", "minLength": 2, "maxLength": 64 },
        "completedTopicIds": { "type": "array" },
        "lastViewedTopicId": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "studentUid", "curriculumId", "completedTopicIds", "updatedAt", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-only user profile and immutable role assignment"
    },
    "/teacherAllowlist/{emailId}": {
      "schema": { "$ref": "#/entities/TeacherAllowlistEntry" },
      "description": "Authorized faculty emails permitted to register Teacher accounts"
    },
    "/classrooms/{classroomId}": {
      "schema": { "$ref": "#/entities/Classroom" },
      "description": "Classroom metadata and enrolled student UID membership"
    },
    "/classrooms/{classroomId}/roster/{studentUid}": {
      "schema": { "$ref": "#/entities/ClassroomRosterEntry" },
      "description": "Isolated student PII roster entries per classroom"
    },
    "/classroomInvites/{joinCode}": {
