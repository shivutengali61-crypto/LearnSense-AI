      "description": "Teacher-published classroom announcements readable by enrolled students"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/AppNotification" },
      "description": "User-scoped real-time notifications"
    },
    "/attendanceSessions/{sessionId}": {
