    },
    "/materialEngagements/{engagementId}": {
      "schema": { "$ref": "#/entities/MaterialEngagement" },
      "description": "Student reading progress per study material"
    },
    "/classroomActivities/{activityId}": {
      "schema": { "$ref": "#/entities/ClassroomActivity" },
      "description": "Scheduled classroom labs, revision clinics, discussions, and assignments"
    },
    "/questionBank/{itemId}": {
      "schema": { "$ref": "#/entities/QuestionBankItem" },
      "description": "Teacher-private reusable concept-tagged question bank"
    },
    "/studentNotes/{noteId}": {
