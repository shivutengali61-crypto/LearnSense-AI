# SARVAM_API_KEY: Required for Sarvam AI multilingual explanations, translation, TTS, and AI concept analysis.
# Configure this in server environment secrets; never expose it in client code.
SARVAM_API_KEY="MY_SARVAM_API_KEY"

# GEMINI_API_KEY: Provided by AI Studio runtime secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Authorised Moodle REST Web Services Adapter (never scrape LMS HTML)
MOODLE_BASE_URL="https://moodle.university.edu"
MOODLE_WS_TOKEN=""

